# ── Supabase (công khai, được đưa vào bundle frontend) ──────────────
# Lấy ở Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Gemini (CHỈ đặt trên Vercel, không bao giờ có tiền tố VITE_) ──
# Lấy ở Google AI Studio → Get API key
GEMINI_API_KEY=
# Để trống để dùng model mặc định của Function
GEMINI_MODEL=

# ── Vercel (CHỈ đặt trong GitHub → Settings → Secrets and variables → Actions) ──
# VERCEL_TOKEN=      # vercel.com/account/tokens
# VERCEL_ORG_ID=     # .vercel/project.json sau khi chạy `vercel link`
# VERCEL_PROJECT_ID= # .vercel/project.json sau khi chạy `vercel link`
